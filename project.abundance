                {
                  "atomType": "GitHubMolecule",
                  "x": 0.408068783068783,
                  "y": 0.7604456824512534,
                  "uniqueID": "id-704",
                  "name": "Isosceles-Triangle---Angle",
                  "ioValues": [
                    {
                      "name": "Angle",
